# 복사해서 .env 로 사용. .env 는 커밋 금지.

# 비우면 ./saipr.db (SQLite)로 동작한다. Docker Compose는 Postgres URL을 자동으로 넣는다.
# DATABASE_URL=postgresql+asyncpg://saipr:saipr@localhost:5432/saipr

# 세션 쿠키 서명 키 — 배포할 때 반드시 긴 난수로 바꾼다:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
# HTTPS로 배포하면 true
SESSION_COOKIE_SECURE=false
# OAuth 콜백 주소를 만들 때 쓰는 외부 주소
PUBLIC_BASE_URL=http://localhost:8000

# 도서 검색 — 비워두면 해당 소스는 자동 비활성화 (Gutendex·위키문헌·Google Books는 키 없이 동작)
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_BOOKS_API_KEY=
WIKISOURCE_LANG=ko

# 소셜 로그인 — 키가 있는 제공자만 로그인 화면에 버튼이 생긴다.
# 콜백 URL은 {PUBLIC_BASE_URL}/auth/{kakao|google|naver}/callback 으로 각 개발자 콘솔에 등록한다.
KAKAO_LOGIN_ENABLED=false
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_LOGIN_ENABLED=false
